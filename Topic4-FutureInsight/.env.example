# Copy to .env when running the stack anywhere other than your own machine.
# docker compose reads .env automatically. Leave it absent entirely for a
# local `docker compose up` — every value below defaults to localhost.
#
# There are two deployment shapes. Pick one; they are not mixed.
# See deploy/README.md for the full picture.


# --- Shape 1: direct, one published port per service (plain http, no proxy)
#
# PUBLIC_HOST is the address people browse to — hostname or IP, no scheme,
# no port. It sets CKAN's site URL and the browser-facing nldt:processLink
# hrefs written into recipes. The UI needs nothing: it derives the backend
# host from the page's own origin at runtime (UI/js/sandboxApi.js).
#
# Every published port (8001-8003, 8010-8014) must be reachable by the
# browser, not just 8000.

#PUBLIC_HOST=83.96.253.60


# --- Shape 2: single-origin gateway (required behind TLS or Cloudflare)
#
# Brought up with:
#   docker compose -f docker-compose.yml -f docker-compose.gateway.yml up -d --build
#
# Everything is served from one origin on GATEWAY_PORT, routed by path
# prefix. This is mandatory behind Cloudflare's proxy, which only forwards a
# fixed port list (HTTPS: 443, 2053, 2083, 2087, 2096, 8443) — the per-service
# ports never reach the origin at all.
#
# PUBLIC_TOOL_BASE switches the nldt:processLink hrefs from ports to paths. Its
# value is the public origin plus the tools prefix; the per-tool segment
# (add, multiply, multiply3, geo-buffer) is appended automatically.

# COMPOSE_FILE saves passing -f twice on every command. Without it, a plain
# `docker compose down` or `logs` uses only the base file and does not know
# the gateway exists — which leaves a stray container behind and is easy to
# miss. The separator is OS-specific: ":" on Linux/macOS, ";" on Windows.
#COMPOSE_FILE=docker-compose.yml:docker-compose.gateway.yml

# GATEWAY_PORT is the HOST side of the mapping only — nginx inside the
# container always listens on 80 (deploy/gateway.conf). Set it to whatever
# port Cloudflare dials on this machine:
#   80   — an orange-clouded A record with SSL/TLS mode "Flexible", which is
#          how the Geonovum testbed deployment is set up. Cloudflare connects
#          inbound to port 80 of the origin, so that is where it must listen.
#   443  — SSL/TLS mode "Full (strict)", with the gateway terminating TLS
#          itself (needs a cert; see deploy/README.md).
#   8080 — Cloudflare Tunnel, or a separate reverse proxy on this host
#          forwarding to it. Nothing dials the origin directly.
#GATEWAY_PORT=80
#PUBLIC_HOST=nldt-tb2.clearly.app
#PUBLIC_TOOL_BASE=https://nldt-tb2.clearly.app/api/tools

# PUBLIC_HOST also tells the Cook Orchestrator which data-input URLs are
# this stack's own (LOCATION_REWRITES in docker-compose.yml and the gateway
# overlay): a recipe's data input is a URL the browser picked, e.g.
# https://<PUBLIC_HOST>/api/hub/datasets/.../data, and the Cook swaps that
# prefix for hub-datasets' internal address when the step's tool runs on this
# stack. Nothing to set beyond PUBLIC_HOST.

# Only if you also proxy CKAN's own UI behind a /ckan prefix. The app itself
# never calls CKAN from the browser, so this is optional.
#CKAN_SITE_URL_OVERRIDE=https://nldt-tb2.clearly.app/ckan
